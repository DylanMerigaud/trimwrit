{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "no-em-dash",
  "displayName": "no-em-dash",
  "description": "Refuses a final message, a file write or a shell write that carries an em dash, an en dash, a figure dash or a horizontal bar. The characters are configurable.",
  "version": "0.1.1",
  "author": { "name": "Dylan Merigaud", "url": "https://github.com/DylanMerigaud" },
  "homepage": "https://github.com/DylanMerigaud/trimwrit/tree/main/plugins/no-em-dash",
  "repository": "https://github.com/DylanMerigaud/trimwrit",
  "license": "MIT",
  "keywords": ["em-dash", "style", "stop-hook", "writing", "gate"],
  "experimental": { "evals": "evals" }
}
