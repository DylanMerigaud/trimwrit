{
  "description": "preamble-gate: no edit and no shell write grows an always-loaded file past its budget unseen",
  "hooks": {
    "PreToolUse": [{"matcher": "Write|Edit|MultiEdit|Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/preamble_gate.py\"", "timeout": 10}]}],
    "PostToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/preamble_gate.py\"", "timeout": 10}]}]
  }
}
